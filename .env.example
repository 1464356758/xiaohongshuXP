# 复制为本地 .env 后请通过 shell export 注入；Node本身不会自动加载.env，推荐用 node --env-file=.env server.mjs
PORT=3000
NODE_ENV=development
GITHUB_REPOS=1464356758/xiaohongshuXP
# 必须是仅具有目标仓库 Contents Read and write 权限的细粒度 token
GITHUB_TOKEN=replace_with_fine_grained_pat
# 设置足够强的后台管理员口令，切勿提交真实值到GitHub
ADMIN_PASSWORD=replace_with_a_unique_strong_password
# 至少24字符随机密钥：可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_very_long_random_secret_value
